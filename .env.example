# Copy to .env for local overrides. Never commit real credentials.

# FastAPI and the single durable SQLite ledger
CODEINSIGHT_MAX_CONCURRENT_ANALYSES=2
CODEINSIGHT_EVENT_HISTORY_LIMIT=200
CODEINSIGHT_MAX_CONCURRENT_MODEL_CALLS=2
# CODEINSIGHT_DATA_DIR=C:\path\to\codeinsight-data
# CODEINSIGHT_DATABASE_PATH=C:\path\to\codeinsight.db

# OpenAI-compatible provider. If omitted, analysis runs in index-only mode.
# CODEINSIGHT_MODEL_BASE_URL=http://127.0.0.1:1234/v1
# CODEINSIGHT_MODEL_API_KEY=
# CODEINSIGHT_DEFAULT_MODEL=local-model

# Optional best-effort Langfuse export. Local analysis never requires it.
# CODEINSIGHT_LANGFUSE_ENABLED=false
# CODEINSIGHT_LANGFUSE_CAPTURE_CONTENT=false
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000
